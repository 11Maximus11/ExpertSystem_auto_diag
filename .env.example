# =====================================================================
# Конфигурация экспертной системы автодиагностики AutoDiag Pro AI
# Все пути к файлам моделей и БД строго относительные!
# =====================================================================

DJANGO_DEBUG=1
DJANGO_SECRET_KEY=autodiag-pro-ai-vulkan-airllm-secret-key

# Стек аппаратного ускорения Vulkan (вместо CUDA)
GGML_VULKAN=1
LLAMA_VULKAN=1
VULKAN_DEVICE=0

# Бюджет под видеокарту с 8 ГБ видеопамяти (например, RTX 3050 8GB)
MAX_VRAM_MB=8192
FREE_VRAM_MB=6800
VULKAN_GPU_LAYERS=37
LLM_CTX_SIZE=2048

# Послойная выгрузка мощных моделей через AirLLM (https://github.com/lyogavin/airllm)
AIRLLM_MODEL_ID=Qwen/Qwen2.5-32B-Instruct
AIRLLM_COMPRESSION=4bit
AIRLLM_LIVE_INFERENCE=0

# Относительный путь к локальной GGUF модели и URL сервера llama.cpp (Vulkan)
GGUF_MODEL_NAME=gemma-4-12b-it-Q4_K_M.gguf
LLAMA_SERVER_URL=http://127.0.0.1:8080/v1
