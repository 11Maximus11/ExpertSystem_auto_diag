# =====================================================================
# Конфигурация экспертной системы автодиагностики «ИИдеал Авто» (AIdeal Auto)
# Все пути к файлам моделей и БД строго относительные!
# =====================================================================

DJANGO_DEBUG=1
DJANGO_SECRET_KEY=aideal-auto-vulkan-airllm-gemma4-secret-key

# Путь к SQLite БД (в Docker по умолчанию используется том /app/db_data/db.sqlite3)
# DJANGO_DB_PATH=/app/db_data/db.sqlite3

# Стек аппаратного ускорения GPU (CUDA TensorCore W4A16 + телеметрия Vulkan)
GGML_VULKAN=1
LLAMA_VULKAN=1
VULKAN_DEVICE=0
# На Linux/Docker используйте max_split_size_mb:256; на Windows можно expandable_segments:True,max_split_size_mb:256
PYTORCH_CUDA_ALLOC_CONF=max_split_size_mb:256

# Автоматическое определение VRAM и калибровка слоев GPU (0..48) через AutoTuner
MAX_VRAM_MB=auto
VRAM_HEADROOM_MB=1280
LLM_CTX_SIZE=32768
AIRLLM_CONTEXT_WINDOW=32768
AIRLLM_TARGET_SLA_SEC=55.0

# Послойная выгрузка Google Gemma 4 12B Unified (Text + Vision + Audio) через AirLLM
AIRLLM_MODEL_ID=google/gemma-4-12B-it-qat-w4a16-ct
AIRLLM_COMPRESSION=4bit

# Кэш Hugging Face (BERT MiniLM + CrossEncoder) и режим RAG v2
HF_TOKEN=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
RAG_USE_NEURAL=1
RAG_DEVICE=cpu
RAG_INCLUDE_EXTERNAL=1
