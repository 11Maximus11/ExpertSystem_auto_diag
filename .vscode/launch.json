{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Django: AIdeal Auto (AirLLM Gemma 4 12B + Adaptive GPU VRAM)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/manage.py",
      "args": [
        "runserver",
        "0.0.0.0:8000",
        "--noreload"
      ],
      "cwd": "${workspaceFolder}",
      "django": true,
      "justMyCode": true,
      "console": "integratedTerminal",
      "env": {
        "PYTHONUTF8": "1",
        "DJANGO_DEBUG": "1",
        "GGML_VULKAN": "1",
        "LLAMA_VULKAN": "1",
        "VULKAN_DEVICE": "0",
        "MAX_VRAM_MB": "8192",
        "LLM_CTX_SIZE": "32768",
        "AIRLLM_MODEL_ID": "google/gemma-4-12B-it-qat-w4a16-ct",
        "AIRLLM_COMPRESSION": "w4a16"
      }
    },
    {
      "name": "Django: Тестирование системы (Gemma 4 + RAG + Worker)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/manage.py",
      "args": [
        "test",
        "diagnostics",
        "-v",
        "2"
      ],
      "cwd": "${workspaceFolder}",
      "django": true,
      "justMyCode": true,
      "console": "integratedTerminal",
      "env": {
        "PYTHONUTF8": "1",
        "GGML_VULKAN": "1",
        "MAX_VRAM_MB": "8192",
        "AUTODIAG_FAST_TEST": "1"
      }
    },
    {
      "name": "RAG Benchmark: Оценка точности и Vulkan (evaluate_model.py)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/evaluate_model.py",
      "cwd": "${workspaceFolder}",
      "justMyCode": true,
      "console": "integratedTerminal",
      "env": {
        "PYTHONUTF8": "1",
        "GGML_VULKAN": "1",
        "MAX_VRAM_MB": "8192"
      }
    },
    {
      "name": "CLI: Локальный запуск AirLLM Gemma 4 12B (MAIN_app_with_LLM.py)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/MAIN_app_with_LLM.py",
      "cwd": "${workspaceFolder}",
      "justMyCode": true,
      "console": "integratedTerminal",
      "env": {
        "PYTHONUTF8": "1",
        "GGML_VULKAN": "1",
        "MAX_VRAM_MB": "8192",
        "LLM_CTX_SIZE": "32768",
        "AIRLLM_MODEL_ID": "google/gemma-4-12B-it-qat-w4a16-ct"
      }
    }
  ]
}
