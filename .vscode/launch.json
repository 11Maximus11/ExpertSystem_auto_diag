{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Django: AutoDiag Pro AI (8GB VRAM Vulkan Debug)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/manage.py",
      "args": [
        "runserver",
        "0.0.0.0:8000",
        "--noreload"
      ],
      "cwd": "${workspaceFolder}",
      "django": true,
      "justMyCode": true,
      "console": "integratedTerminal",
      "env": {
        "PYTHONUTF8": "1",
        "DJANGO_DEBUG": "1",
        "GGML_VULKAN": "1",
        "LLAMA_VULKAN": "1",
        "VULKAN_DEVICE": "0",
        "MAX_VRAM_MB": "8192",
        "FREE_VRAM_MB": "6800",
        "VULKAN_GPU_LAYERS": "37",
        "LLM_CTX_SIZE": "2048",
        "AIRLLM_MODEL_ID": "Qwen/Qwen2.5-32B-Instruct",
        "AIRLLM_COMPRESSION": "4bit"
      }
    },
    {
      "name": "Django: Тестирование системы (Vulkan + Воркер + JSON)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/manage.py",
      "args": [
        "test",
        "diagnostics",
        "-v",
        "2"
      ],
      "cwd": "${workspaceFolder}",
      "django": true,
      "justMyCode": true,
      "console": "integratedTerminal",
      "env": {
        "PYTHONUTF8": "1",
        "GGML_VULKAN": "1",
        "MAX_VRAM_MB": "8192"
      }
    },
    {
      "name": "RAG Benchmark: Оценка точности и Vulkan (evaluate_model.py)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/evaluate_model.py",
      "cwd": "${workspaceFolder}",
      "justMyCode": true,
      "console": "integratedTerminal",
      "env": {
        "PYTHONUTF8": "1",
        "GGML_VULKAN": "1",
        "MAX_VRAM_MB": "8192"
      }
    },
    {
      "name": "CLI: Локальный запуск GGUF Vulkan (MAIN_app_with_LLM.py)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/MAIN_app_with_LLM.py",
      "cwd": "${workspaceFolder}",
      "justMyCode": true,
      "console": "integratedTerminal",
      "env": {
        "PYTHONUTF8": "1",
        "GGML_VULKAN": "1",
        "MAX_VRAM_MB": "8192",
        "LLM_CTX_SIZE": "2048"
      }
    }
  ]
}
