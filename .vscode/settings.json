{
  "python.defaultInterpreterPath": "${workspaceFolder}/.venv/Scripts/python.exe",
  "python.terminal.activateEnvironment": true,
  "files.encoding": "utf8",
  "files.eol": "\n",
  "terminal.integrated.env.windows": {
    "PYTHONUTF8": "1",
    "GGML_VULKAN": "1",
    "LLAMA_VULKAN": "1",
    "MAX_VRAM_MB": "8192",
    "LLM_CTX_SIZE": "2048",
    "AIRLLM_COMPRESSION": "4bit"
  },
  "terminal.integrated.env.linux": {
    "PYTHONUTF8": "1",
    "GGML_VULKAN": "1",
    "LLAMA_VULKAN": "1",
    "MAX_VRAM_MB": "8192",
    "LLM_CTX_SIZE": "2048",
    "AIRLLM_COMPRESSION": "4bit"
  }
}
