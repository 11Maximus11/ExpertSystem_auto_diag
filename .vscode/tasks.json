{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Django: Применить миграции БД",
      "type": "shell",
      "command": "${workspaceFolder}/.venv/Scripts/python.exe",
      "linux": {
        "command": "${workspaceFolder}/.venv/bin/python"
      },
      "args": [
        "manage.py",
        "migrate"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Vulkan: Запустить локальный llama-server (8GB VRAM)",
      "type": "shell",
      "windows": {
        "command": "${workspaceFolder}/llama/start_server.bat"
      },
      "linux": {
        "command": "bash",
        "args": [
          "${workspaceFolder}/llama/start_server.sh"
        ]
      },
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "Тесты: Проверить RAG, Воркер контекста и JSON Schema",
      "type": "shell",
      "command": "${workspaceFolder}/.venv/Scripts/python.exe",
      "linux": {
        "command": "${workspaceFolder}/.venv/bin/python"
      },
      "args": [
        "manage.py",
        "test",
        "diagnostics"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Docker: Собрать и запустить контейнер с Vulkan",
      "type": "shell",
      "command": "docker",
      "args": [
        "compose",
        "up",
        "--build"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    }
  ]
}
