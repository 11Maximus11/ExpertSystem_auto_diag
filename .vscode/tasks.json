{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Android: Запустить эмулятор Pixel 5 (API 34)",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/.vscode/scripts/run_emulator.ps1",
        "-Avd",
        "pixel_5_-_api_34"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "Android: Запустить эмулятор Pixel 7 (API 26)",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/.vscode/scripts/run_emulator.ps1",
        "-Avd",
        "pixel_7_-_api_26_0"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "Android: Собрать и запустить APK (le.codes)",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/.vscode/scripts/build_and_run.ps1"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "Android: Hot-Reload JS бандла (le.codes sync)",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-Command",
        "cd '${workspaceFolder}/lecodes_webapp'; npx lecodes-cli app sync android; & 'C:\\Program Files (x86)\\Android\\android-sdk\\platform-tools\\adb.exe' shell am force-stop com.mmcco.aidealauto; & 'C:\\Program Files (x86)\\Android\\android-sdk\\platform-tools\\adb.exe' shell am start -n com.mmcco.aidealauto/.MainActivity"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "Android: Пробросить порт 8000 (adb reverse)",
      "type": "shell",
      "command": "C:\\Program Files (x86)\\Android\\android-sdk\\platform-tools\\adb.exe",
      "args": [
        "reverse",
        "tcp:8000",
        "tcp:8000"
      ],
      "problemMatcher": []
    },
    {
      "label": "Android: Показать Logcat (LeCodes + AIdeal)",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-Command",
        "& 'C:\\Program Files (x86)\\Android\\android-sdk\\platform-tools\\adb.exe' logcat -v time -s LeCodes:V CreatorPkg:V AIdealMainActivity:V AndroidRuntime:E"
      ],
      "problemMatcher": [],
      "isBackground": true,
      "presentation": {
        "reveal": "always",
        "panel": "new"
      }
    },
    {
      "label": "Django: Применить миграции БД",
      "type": "shell",
      "command": "${workspaceFolder}/.venv/Scripts/python.exe",
      "linux": {
        "command": "${workspaceFolder}/.venv/bin/python"
      },
      "args": [
        "manage.py",
        "migrate"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "AirLLM: Скачать и нарезать Google Gemma 4 12B на послойные шарды",
      "type": "shell",
      "command": "${workspaceFolder}/.venv/Scripts/python.exe",
      "linux": {
        "command": "${workspaceFolder}/.venv/bin/python"
      },
      "args": [
        "prepare_airllm_model.py"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Тесты: Проверить RAG, Воркер контекста и JSON Schema",
      "type": "shell",
      "command": "${workspaceFolder}/.venv/Scripts/python.exe",
      "linux": {
        "command": "${workspaceFolder}/.venv/bin/python"
      },
      "args": [
        "manage.py",
        "test",
        "diagnostics"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Docker: Собрать и запустить контейнер с AirLLM и GPU",
      "type": "shell",
      "command": "docker",
      "args": [
        "compose",
        "up",
        "--build"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    }
  ]
}
